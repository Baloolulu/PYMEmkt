# ───────────────────────────────────────────────
# PYMEmkt — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# Todas son opcionales: el sitio funciona sin ellas, pero
# algunas funciones se ocultan o degradan con elegancia.
# ───────────────────────────────────────────────

# URL pública final (sin "/" al final). Se usa en SEO, Open Graph, sitemap y para compartir resultados.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# WhatsApp en formato internacional, solo dígitos. Ej. México: 52 + 10 dígitos → 525512345678
# Si se deja vacío, se ocultan los botones de WhatsApp directos (compartir resultado sigue funcionando).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Solo para vistas previas sin número (déjalo vacío en producción)
NEXT_PUBLIC_DEMO_MODE=

# Correo de contacto público (opcional). Aparece en el pie y como respaldo del formulario.
NEXT_PUBLIC_CONTACT_EMAIL=

# Analítica (opcionales). Si están vacíos, no se carga ningún script.
# GA4: G-XXXXXXXXXX · Meta Pixel: solo dígitos
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Redes sociales (opcionales)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=


# ── Solo servidor ──
# Webhook que recibe cada solicitud del formulario como JSON (Make, Zapier, n8n, Google Apps Script, CRM…).
LEAD_WEBHOOK_URL=
# Secreto opcional que se envía en el encabezado X-Webhook-Secret
LEAD_WEBHOOK_SECRET=
