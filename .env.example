# ───────────────────────────────────────────────────────────────
# PYMEmkt — variables de entorno (referencia completa)
#
# Dónde va cada una:
#   · Públicas compartidas → ya están en .env.production / .env.development
#   · Por entorno y secretas → Vercel → Settings → Environment Variables
#   · Pruebas locales con secretos → copia este archivo como .env.local
# Detalle y valores por entorno: PUBLICACION.md
# ───────────────────────────────────────────────────────────────

# Entorno: production (dominio final, se indexa) | staging (pruebas, no se indexa)
NEXT_PUBLIC_APP_ENV=staging

# URL pública sin "/" final. Obligatoria en producción: https://pymemkt.com.mx
# En staging puede quedar vacía: se usa la URL que asigna Vercel.
NEXT_PUBLIC_SITE_URL=

# Contacto público (definidos en .env.production)
NEXT_PUBLIC_WHATSAPP_NUMBER=525579270123
NEXT_PUBLIC_CONTACT_EMAIL=contacto@pymemkt.com.mx
NEXT_PUBLIC_DEMO_MODE=false

# ── Recepción del formulario (SOLO SERVIDOR, nunca con NEXT_PUBLIC_) ──
# Correo que recibe las solicitudes
LEAD_EMAIL_TO=contacto@pymemkt.com.mx
# Remitente. Con SMTP de Titan debe ser el mismo buzón autenticado.
LEAD_EMAIL_FROM=PYMEmkt Web <contacto@pymemkt.com.mx>

# Opción A (recomendada, sin cambios de DNS): SMTP del buzón en Titan Email
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@pymemkt.com.mx
SMTP_PASS=

# Opción B: Resend (requiere verificar el dominio con registros DNS)
RESEND_API_KEY=

# Opcional: copia de cada solicitud a Google Sheets, Make, Zapier o un CRM
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ── Protección contra abuso (SOLO SERVIDOR salvo la site key) ──
# Límite de envíos compartido entre instancias (Upstash Redis; la integración de Vercel crea KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile (opcional, recomendado si llegan envíos automatizados)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analítica (opcionales; solo cargan con consentimiento del visitante) ──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Redes sociales (opcionales) ──
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
